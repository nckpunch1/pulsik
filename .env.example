TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=@pulseiq_au
# Required: protects the weekly-post cron endpoint (Vercel sends it as Authorization: Bearer <secret>)
CRON_SECRET=your_secret_here

# Conversational AI
GROQ_API_KEY=your_groq_api_key_here
# Optional model overrides (defaults shown)
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=qwen/qwen3-32b
# Vercel Redis — injected automatically when you connect a Redis store in Vercel
REDIS_URL=redis://...
# Required: random string used to verify incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
