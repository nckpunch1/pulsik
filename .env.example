# Copy to .env locally. Never commit real credentials.
BOT_ENV=staging
BOT_USERNAME=pulse_iq_bot
TELEGRAM_BOT_TOKEN=your_token_here
TELEGRAM_CHAT_ID=your_channel_id_here
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
CRON_SECRET=your_secret_here
REDIS_URL=redis://...
GROQ_API_KEY=your_groq_api_key_here
WEBHOOK_URL=https://pulsik.vercel.app
# Numeric Telegram user IDs; operators must start the bot in a DM to receive alerts.
OPERATOR_USER_IDS=
# Numeric group IDs, comma-separated. Empty disables every group.
ALLOWED_GROUP_IDS=
# Safe launch defaults. Enable explicitly after testing and initializing rotation.
# DM-only mode: anyone may chat privately, no groups or public publications.
PRIVATE_TEST_MODE=false
CHAT_ENABLED=false
WEEKLY_ENABLED=false
# First Wednesday date approved for weekly publication (YYYY-MM-DD).
WEEKLY_START_DATE=
# Background group context and theatrical persona are opt-in.
GROUP_CONTEXT_ENABLED=false
ALTERNATE_PERSONA_ENABLED=false
GLOBAL_DAILY_REPLY_LIMIT=300
GLOBAL_MINUTE_REPLY_LIMIT=30
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
